default_platform(:ios)

APP_IDENTIFIER = "com.sashkyn.kekable"

APP_IDENTIFIERS = [
  "com.sashkyn.kekable", 
  #"com.sashkyn.kekable.watchkitapp",
  "com.sashkyn.kekable.widget"
]

PROVISIONING_PROFILES = {
  "com.sashkyn.kekable" => "match AppStore com.sashkyn.kekable",
  #"com.sashkyn.kekable.watchkitapp" => "match AppStore com.sashkyn.kekable.watchkitapp",
  "com.sashkyn.kekable.widget" => "match AppStore com.sashkyn.kekable.widget"
}

def delete_temp_keychain(name)
  delete_keychain(
    name: name
  ) if File.exist? File.expand_path("~/Library/Keychains/#{name}-db")
end

def create_temp_keychain(name, password)
  create_keychain(
    name: name,
    password: password,
    unlock: false,
    timeout: 0,
    default_keychain: true
  )
end

def ensure_temp_keychain(name, password)
  delete_temp_keychain(name)
  create_temp_keychain(name, password)
end

platform :ios do
  desc "Create provisioning profiles"
  lane :create_provisioning_profiles do
    match(
      username: "#{ENV["APPLE_ID"]}",
      team_id: "#{ENV["APPLE_TEAM_ID"]}",
      app_identifier: APP_IDENTIFIERS,
      git_basic_authorization: "#{ENV["FASTLANE_GITHUB_BASIC_AUTH_BASE64"]}",
      git_url: "#{ENV["FASTLANE_MATCH_GIT_URL"]}",
      readonly: false,
      type: "development"
    )
    match(
      username: "#{ENV["APPLE_ID"]}",
      team_id: "#{ENV["APPLE_TEAM_ID"]}",
      app_identifier: APP_IDENTIFIERS,
      git_basic_authorization: "#{ENV["FASTLANE_GITHUB_BASIC_AUTH_BASE64"]}",
      git_url: "#{ENV["FASTLANE_MATCH_GIT_URL"]}",
      readonly: false,
      type: "appstore",
    )
  end
end


platform :ios do
  desc "Archive, Build IPA, Signing, Upload to TestFilght"
  lane :build_and_upload_to_testfilght do
    keychain_name = ENV["TEMP_KEYCHAIN_NAME"]
    keychain_password = ENV["TEMP_KEYCHAIN_PASSWORD"]
    ensure_temp_keychain(
      keychain_name, 
      keychain_password
    )
    api_key = app_store_connect_api_key(
      key_id: "#{ENV["APPSTORE_KEY_ID"]}",
      issuer_id: "#{ENV["APPSTORE_ISSUER_ID"]}",
      key_content: "#{ENV["APPSTORE_API_KEY_CONTENT_BASE_64"]}",
      is_key_content_base64: true
    )
    match(
      username: "#{ENV["APPLE_ID"]}",
      team_id: "#{ENV["APPLE_TEAM_ID"]}",
      app_identifier: APP_IDENTIFIERS,
      git_basic_authorization: "#{ENV["FASTLANE_GITHUB_BASIC_AUTH_BASE64"]}",
      git_url: "#{ENV["FASTLANE_MATCH_GIT_URL"]}",
      type: "development",
      api_key: api_key,
      readonly: true,
      keychain_name: keychain_name,
      keychain_password: keychain_password,
      force_for_new_devices: true
    )
    match(
      username: "#{ENV["APPLE_ID"]}",
      team_id: "#{ENV["APPLE_TEAM_ID"]}",
      app_identifier: APP_IDENTIFIERS,
      git_basic_authorization: "#{ENV["FASTLANE_GITHUB_BASIC_AUTH_BASE64"]}",
      git_url: "#{ENV["FASTLANE_MATCH_GIT_URL"]}",
      type: "appstore",
      api_key: api_key,
      readonly: true,
      keychain_name: keychain_name,
      keychain_password: keychain_password,
      force_for_new_devices: true
    )
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.sashkyn.kekable",
      initial_build_number: 0,
    )
    next_build = latest_build + 1
    UI.message("📈 Build number: #{next_build} (latest on TestFlight: #{latest_build})")
    sh("flutter build ios --config-only --release --build-number=#{next_build}")
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: PROVISIONING_PROFILES
      },
      verbose: true
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      ipa: "./Runner.ipa"
    )
    delete_temp_keychain(keychain_name)
  end
end

platform :ios do
  desc "Locally: Archive * Build IPA * Signing * Upload to TF"
  lane :build_and_upload_to_testfilght_from_local_machine do
    api_key = app_store_connect_api_key(
      key_id: "#{ENV["APPSTORE_KEY_ID"]}",
      issuer_id: "#{ENV["APPSTORE_ISSUER_ID"]}",
      key_content: "#{ENV["APPSTORE_API_KEY_CONTENT_BASE_64"]}",
      is_key_content_base64: true
    )
    match(
      username: "#{ENV["APPLE_ID"]}",
      team_id: "#{ENV["APPLE_TEAM_ID"]}",
      app_identifier: APP_IDENTIFIERS,
      git_basic_authorization: "#{ENV["FASTLANE_GITHUB_BASIC_AUTH_BASE64"]}",
      git_url: "#{ENV["FASTLANE_MATCH_GIT_URL"]}",
      type: "development",
      api_key: api_key,
      readonly: false,
    )
    match(
      username: "#{ENV["APPLE_ID"]}",
      team_id: "#{ENV["APPLE_TEAM_ID"]}",
      app_identifier: APP_IDENTIFIERS,
      git_basic_authorization: "#{ENV["FASTLANE_GITHUB_BASIC_AUTH_BASE64"]}",
      git_url: "#{ENV["FASTLANE_MATCH_GIT_URL"]}",
      type: "appstore",
      api_key: api_key,
      readonly: false,
    )
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.sashkyn.kekable",
      initial_build_number: 0,
    )
    next_build = latest_build + 1
    UI.message("📈 Build number: #{next_build} (latest on TestFlight: #{latest_build})")
    sh("fvm flutter build ios --config-only --release --build-number=#{next_build}")
    build_app(
      workspace: "Runner.xcworkspace", 
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: PROVISIONING_PROFILES
      },
      verbose: true
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      ipa: "./Runner.ipa"
    )
  end
end

platform :ios do
  desc "Submit the newest TestFlight build for App Store review"
  desc "Usage: bundle exec fastlane submit_to_review notes:\"What changed\""
  lane :submit_to_review do |options|
    notes = options[:notes].to_s.strip
    UI.user_error!("notes: is required — see ADR-0006") if notes.empty?

    version = File.read(File.expand_path("../../pubspec.yaml", __dir__))[/^version:\s*([^\s+]+)/, 1]
    UI.user_error!("Could not read version from pubspec.yaml") if version.nil?

    api_key = app_store_connect_api_key(
      key_id: "#{ENV["APPSTORE_KEY_ID"]}",
      issuer_id: "#{ENV["APPSTORE_ISSUER_ID"]}",
      key_content: "#{ENV["APPSTORE_API_KEY_CONTENT_BASE_64"]}",
      is_key_content_base64: true
    )

    # The same app record also holds a live macOS app, so every lookup is pinned
    # to iOS — otherwise a macOS version can be picked up instead. See ADR-0006 D4.
    app_store_build_number(api_key: api_key, app_identifier: APP_IDENTIFIER, platform: "ios", live: true)
    live_version = lane_context[SharedValues::LATEST_VERSION].to_s
    if live_version == version
      UI.user_error!("pubspec version #{version} is already live on the App Store — bump pubspec.yaml first")
    end

    build = latest_testflight_build_number(api_key: api_key, app_identifier: APP_IDENTIFIER, initial_build_number: 0)
    UI.message("🚀 Submitting #{version} (build #{build}) for review — live is #{live_version}")

    # deliver manages the WHOLE store listing. This tree deliberately holds only
    # release notes, and screenshots/binary upload are skipped, so a submission
    # can never overwrite the live description, keywords or screenshots.
    notes_file = File.join(__dir__, "metadata", "en-US", "release_notes.txt")
    FileUtils.mkdir_p(File.dirname(notes_file))
    File.write(notes_file, "#{notes}\n")
    UI.message("📝 Release notes → #{notes_file}")

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      app_version: version,
      build_number: build.to_s,
      metadata_path: File.join(__dir__, "metadata"),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end

  desc "Register new device"
  lane :register_new_device do  |options|
    api_key = app_store_connect_api_key(
      key_id: "#{ENV["APPSTORE_KEY_ID"]}",
      issuer_id: "#{ENV["APPSTORE_ISSUER_ID"]}",
      key_content: "#{ENV["APPSTORE_API_KEY_CONTENT_BASE_64"]}",
      is_key_content_base64: true
    )
    device_name = prompt(text: "Enter the device name: ")
    device_udid = prompt(text: "Enter the device UDID: ")
    device_hash = {}
    device_hash[device_name] = device_udid
    register_devices(devices: device_hash)
  end
end

platform :ios do
  desc "Revoke all certificates"
  lane :revoke_all_certificates do  |options|
    api_key = app_store_connect_api_key(
      key_id: "#{ENV["APPSTORE_KEY_ID"]}",
      issuer_id: "#{ENV["APPSTORE_ISSUER_ID"]}",
      key_content: "#{ENV["APPSTORE_API_KEY_CONTENT_BASE_64"]}",
      is_key_content_base64: true
    )
    match_nuke(
      username: "#{ENV["APPLE_ID"]}",
      team_id: "#{ENV["APPLE_TEAM_ID"]}",
      app_identifier: APP_IDENTIFIERS,
      git_basic_authorization: "#{ENV["FASTLANE_GITHUB_BASIC_AUTH_BASE64"]}",
      git_url: "#{ENV["FASTLANE_MATCH_GIT_URL"]}",
      type: "development",
      api_key: api_key,
      safe_remove_certs: true
    )
    match_nuke(
      username: "#{ENV["APPLE_ID"]}",
      team_id: "#{ENV["APPLE_TEAM_ID"]}",
      app_identifier: APP_IDENTIFIERS,
      git_basic_authorization: "#{ENV["FASTLANE_GITHUB_BASIC_AUTH_BASE64"]}",
      git_url: "#{ENV["FASTLANE_MATCH_GIT_URL"]}",
      type: "appstore",
      api_key: api_key,
      safe_remove_certs: true
    )
  end
end
