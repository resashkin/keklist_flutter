# Fastfile for keklist Android builds
#
# Available lanes:
#
# Play Store:
#   bundle exec fastlane build_and_upload_to_internal  # Build AAB and upload to internal testing
#   bundle exec fastlane build_aab_flutter              # Build AAB only (for testing)
#
# Firebase App Distribution:
#   bundle exec fastlane distribute_firebase            # Distribute to default testers group
#   bundle exec fastlane distribute_firebase_with_notes notes:"Release notes" groups:"testers,beta"
#
# Workarounds:
#   bundle exec fastlane patch_revenuecat_k2            # Patch purchases_ui_flutter K2 compiler bug
#
# Or use the helper script from project root:
#   ./scripts/distribute_android.sh "Release notes" "group1,group2"

default_platform(:android)

platform :android do
  # Version codes on a track, or [] if that track does not exist. Reading a
  # missing track raises (the 'alpha' track does), so each read is isolated
  # rather than allowed to abort whatever is asking.
  def track_codes(track)
    google_play_track_version_codes(track: track).compact
  rescue => e
    UI.important("Could not read '#{track}' track (#{e.message}); ignoring it")
    []
  end

  desc "Build AAB and upload to Play Store internal testing track"
  lane :build_and_upload_to_internal do
    # Same K2 workaround the Firebase lane applies before building.
    sh("bash #{File.expand_path('../../scripts/patch_revenuecat_k2.sh', __dir__)}")

    # Play rejects a version code any track has already consumed, so derive the
    # next one from the highest in use rather than trusting pubspec.yaml.
    codes = %w[internal alpha beta production].flat_map { |track| track_codes(track) }
    latest_build = codes.max || 0
    next_build = latest_build + 1
    UI.message("📈 Version code: #{next_build} (latest on Play: #{latest_build})")

    # Build Flutter app for Android
    sh("cd .. && fvm flutter build appbundle --release --build-number=#{next_build}")

    # Upload to Play Store internal testing track
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the newest internal build to production at 100%"
  desc "Usage: bundle exec fastlane promote_to_production notes:\"What changed\""
  lane :promote_to_production do |options|
    notes = options[:notes].to_s.strip
    UI.user_error!("notes: is required — see ADR-0005") if notes.empty?

    internal = track_codes("internal").max
    production = track_codes("production").max || 0
    UI.user_error!("No build on the internal track to promote") if internal.nil?
    if internal <= production
      UI.user_error!("Internal (#{internal}) is not ahead of production (#{production}); nothing to promote")
    end
    UI.message("🚀 Promoting #{internal} → production (currently #{production}), full release")

    # supply has no inline notes option: it reads them from the metadata tree.
    # That tree deliberately holds changelogs only, so nothing here can overwrite
    # the store listing. See ADR-0005.
    changelog = File.join(__dir__, "metadata", "android", "en-US", "changelogs", "#{internal}.txt")
    FileUtils.mkdir_p(File.dirname(changelog))
    File.write(changelog, "#{notes}\n")
    UI.message("📝 Release notes → #{changelog}")

    upload_to_play_store(
      version_code: internal,
      track: "internal",
      track_promote_to: "production",
      release_status: "completed",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :android do
  desc "Build AAB only (for testing)"
  lane :build_aab_flutter do
    sh("cd .. && flutter build appbundle --release")
  end

  desc "Patch purchases_ui_flutter MapHelper.kt to fix Kotlin K2 compiler visibility bug"
  lane :patch_revenuecat_k2 do
    sh("bash ../../scripts/patch_revenuecat_k2.sh")
  end

  desc "Build APK and distribute to Firebase App Distribution"
  lane :distribute_firebase do
    # Build Flutter app for Android (APK for distribution)
    sh("cd .. && fvm flutter build apk --release")

    # Build Firebase CLI command with absolute path (go up from android/fastlane to project root)
    apk_path = File.expand_path("../../build/app/outputs/flutter-apk/app-release.apk", __dir__)
    firebase_cmd = "firebase appdistribution:distribute \"#{apk_path}\""
    firebase_cmd += " --app #{ENV['FIREBASE_APP_ID']}"
    firebase_cmd += " --groups \"android-testers\""
    firebase_cmd += " --release-notes \"New build from CI/CD\""

    # Add token if set (for CI/CD)
    if ENV["FIREBASE_TOKEN"] && !ENV["FIREBASE_TOKEN"].empty?
      firebase_cmd += " --token #{ENV['FIREBASE_TOKEN']}"
    end

    # Execute Firebase CLI command
    sh(firebase_cmd)
  end

  desc "Build APK and distribute to Firebase with custom release notes"
  lane :distribute_firebase_with_notes do |options|
    # Build Flutter app for Android (APK for distribution)
    sh("cd .. && fvm flutter build apk --release")

    # Get release notes from parameter or use default
    release_notes = options[:notes] || "New build"
    groups = options[:groups] || "android-testers"
    testers = options[:testers]

    # Build Firebase CLI command with absolute path (go up from android/fastlane to project root)
    apk_path = File.expand_path("../../build/app/outputs/flutter-apk/app-release.apk", __dir__)
    firebase_cmd = "firebase appdistribution:distribute \"#{apk_path}\""
    firebase_cmd += " --app #{ENV['FIREBASE_APP_ID']}"
    firebase_cmd += " --release-notes \"#{release_notes}\""

    # Add groups or testers
    if testers && !testers.empty?
      firebase_cmd += " --testers \"#{testers}\""
    elsif groups && !groups.empty?
      firebase_cmd += " --groups \"#{groups}\""
    end

    # Add token if set (for CI/CD)
    if ENV["FIREBASE_TOKEN"] && !ENV["FIREBASE_TOKEN"].empty?
      firebase_cmd += " --token #{ENV['FIREBASE_TOKEN']}"
    end

    # Execute Firebase CLI command
    sh(firebase_cmd)
  end
end
